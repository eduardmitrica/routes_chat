# Copy to .env (git-ignored), then run with --dart-define-from-file=.env.
# The values are in the Firebase console, under Project settings > Your apps.
# The keys match Environment (lib/infrastructure/core/environment.dart), and a
# test keeps the two in sync.

# Named Firestore database. This project has no "(default)" database.
FIRESTORE_DATABASE_ID=

# Shared by every platform.
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# Android app.
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=

# iOS app, also used for macOS.
FIREBASE_APPLE_API_KEY=
FIREBASE_APPLE_APP_ID=
FIREBASE_APPLE_BUNDLE_ID=

# Web app. Windows shares its API key and auth domain.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_MEASUREMENT_ID=

# Windows app.
FIREBASE_WINDOWS_APP_ID=
FIREBASE_WINDOWS_MEASUREMENT_ID=

# Google Sign-In OAuth clients. The server client is the "Web application" one.
GOOGLE_SERVER_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Optional. The App Check debug token of this development machine's builds,
# registered in the Firebase console under App Check > Apps > Manage debug
# tokens. Release builds use Play Integrity or App Attest instead.
APP_CHECK_DEBUG_TOKEN=
