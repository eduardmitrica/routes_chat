rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // True when, once the current write lands, the `usernames` entry for
    // [username] belongs to the caller.
    function claimsUsername(username) {
      return getAfter(/databases/$(database)/documents/usernames/$(username))
        .data.uid == request.auth.uid;
    }

    // True when the caller signed in, or confirmed their sign-in, in the last
    // 5 minutes. `auth_time` is that moment in seconds; refreshing the ID
    // token does not change it.
    function signedInRecently() {
      return request.time <
        timestamp.value(request.auth.token.auth_time * 1000) +
          duration.value(5, 'm');
    }

    // Shared by one-to-one chats and groups.

    // Must match what MessageDataTransferObject stores; a test checks it.
    // A chat's lastMessage also carries the message's id. Older versions of
    // the app also write repliedMessageId, always "Empty", which stays
    // allowed so they keep working: a reply's link is now encrypted.
    function messageFields() {
      return ['senderId', 'imageUrls', 'reactions', 'content',
              'repliedMessageId', 'isEdited', 'serverTimeStamp'];
    }

    // A message encrypted under generation [generation] of the chat key
    // (EncryptedContent in the app): base64 of a 12-byte nonce, the
    // ciphertext and a 16-byte tag. A message is at most 1000 UTF-16 code
    // units. Version 1, which older versions of the app still write, holds
    // the text alone: at most 3000 bytes of UTF-8, 4000 characters of
    // base64. Version 2 holds, as JSON, the text, any quote and the list of
    // attached photos and GIFs with their keys and small previews. Escapes
    // take up to six bytes a code unit, and ten attachments with previews
    // about 22000 bytes: at most 36000 bytes, 48000 characters.
    function isEncryptedContent(content, generation) {
      return content.keys().hasOnly(['v', 'e', 'nonce', 'cipherText', 'mac']) &&
        content.e == generation &&
        content.nonce is string && content.nonce.size() == 16 &&
        content.mac is string && content.mac.size() == 24 &&
        content.cipherText is string &&
        ((content.v == 1 && content.cipherText.size() <= 4000) ||
         (content.v == 2 && content.cipherText.size() <= 48000));
    }

    // The chat key sealed to one participant (SealedChatKey in the app):
    // base64 of a 32-byte ephemeral X25519 public key, a 12-byte nonce, the
    // 32-byte encrypted key and a 16-byte tag, and the version of the
    // participant's keys it was sealed to.
    function isSealedChatKey(sealed) {
      return sealed.keys().hasOnly(['ephemeralPublicKey', 'nonce',
                                    'cipherText', 'mac', 'keyVersion']) &&
        sealed.ephemeralPublicKey is string &&
        sealed.ephemeralPublicKey.size() == 44 &&
        sealed.nonce is string && sealed.nonce.size() == 16 &&
        sealed.cipherText is string && sealed.cipherText.size() == 44 &&
        sealed.mac is string && sealed.mac.size() == 24 &&
        sealed.keyVersion is int;
    }

    // A message the caller wrote under generation [generation], holding only
    // the fields the app stores, with its text encrypted.
    function isOwnEncryptedMessage(message, fields, generation) {
      return message.keys().hasOnly(fields) &&
        message.senderId == request.auth.uid &&
        isEncryptedContent(message.content, generation);
    }

    // The version of stored keys. Keys from before key resets existed carry
    // none: they are a user's first.
    function keyVersionOf(keys) {
      return keys.get('keyVersion', 1);
    }

    // Profiles are readable by any signed-in user, because username search
    // looks up other users; registration checks uniqueness against the
    // `usernames` index below, and the Google flows sign in first and read the
    // caller's own profile. Because anyone signed in can read them, profiles
    // hold only what everyone may see. Email addresses live in Firebase Auth
    // alone, and `hasOnly(profileFields())` rejects any other field, so an old
    // or modified client cannot write one back.
    //
    // A profile may only carry a username whose index entry belongs to the
    // same uid once the write lands, which makes uniqueness enforced here
    // rather than a client-side courtesy.
    match /users/{userId} {
      // Must match the fields UserDataTransferObject stores; a test checks it.
      function profileFields() {
        return ['username', 'imageUrl', 'description'];
      }

      allow read: if signedIn();
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(profileFields()) &&
        claimsUsername(request.resource.data.username);
      allow update: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(profileFields()) &&
        (request.resource.data.username == resource.data.username ||
         claimsUsername(request.resource.data.username));
      allow delete: if signedIn() && request.auth.uid == userId;

      // This user's devices for push notifications, one document per FCM
      // token. Private to the owner, who adds a device when signing in and
      // removes it before signing out. The notifyNewMessage Cloud Function
      // reads them with the Admin SDK, which is not subject to these rules.
      match /fcmTokens/{token} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() &&
          request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['platform', 'updatedAt']) &&
          request.resource.data.updatedAt == request.time;
      }

      // What this user decided about a chat from someone who is not their
      // friend: accepted into their chats, or deleted for now (a later
      // message brings it back as a request). Private to them: the sender is
      // never told. The id is the chat's.
      match /chatRequests/{chatId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() &&
          request.auth.uid == userId &&
          request.auth.uid in chatId.split('_') &&
          request.resource.data.keys().hasOnly(['state', 'at']) &&
          request.resource.data.state in ['accepted', 'deleted'] &&
          request.resource.data.at == request.time;
      }

      // This user's messaging settings, private to them: whether people who
      // are not their friends may reach them at all. The notification
      // functions read it with the Admin SDK, so a message that may not
      // reach them never rings.
      match /settings/{document} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() &&
          request.auth.uid == userId &&
          document == 'messaging' &&
          request.resource.data.keys().hasOnly(['allowFromAnyone']) &&
          request.resource.data.allowFromAnyone is bool;
        allow delete: if false;
      }

      // The people this user blocked, one document each, private to the
      // owner: a block is silent, and the blocked person cannot tell. While
      // someone is blocked, blockedSince is the server time the block started;
      // earlier holds past blocks, at most 100 (FirestoreSafetyRepository), so
      // what they sent then stays hidden after unblocking. The notification
      // functions read it with the Admin SDK, to announce nothing from them.
      match /blocks/{blockedId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() &&
          request.auth.uid == userId &&
          blockedId != userId &&
          request.resource.data.keys().hasOnly(['blockedSince', 'earlier']) &&
          (request.resource.data.get('blockedSince', null) == null ||
           request.resource.data.blockedSince == request.time ||
           (resource != null &&
            request.resource.data.blockedSince ==
              resource.data.get('blockedSince', null))) &&
          request.resource.data.get('earlier', []) is list &&
          request.resource.data.get('earlier', []).size() <= 100;
      }

      // The user's end-to-end encryption keys (see docs/e2ee.md). Everything
      // in the bundle except the public key is encrypted, but only the owner
      // has any reason to read it. The client can never delete it, because
      // losing it would make every earlier message unreadable.
      match /private/{document} {
        // Must match what KeyBundle stores; a test checks it.
        function encryptionBundleFields() {
          return ['version', 'keyVersion', 'kdf', 'masterKeyByPassphrase',
                  'masterKeyByRecoveryKey', 'privateKey', 'publicKey'];
        }

        function isValidBundle() {
          return document == 'encryption' &&
            request.resource.data.keys().hasOnly(encryptionBundleFields()) &&
            request.resource.data.version == 1 &&
            request.resource.data.keyVersion is int;
        }

        // The published public key as it will be once this write lands.
        function publishedKeysAfter() {
          return getAfter(/databases/$(database)/documents/userKeys/$(userId))
            .data;
        }

        allow read: if signedIn() && request.auth.uid == userId;
        // Created together with the published public key, which must match.
        allow create: if signedIn() &&
          request.auth.uid == userId &&
          isValidBundle() &&
          request.resource.data.keyVersion == 1 &&
          publishedKeysAfter().publicKey == request.resource.data.publicKey;
        allow update: if signedIn() &&
          request.auth.uid == userId &&
          isValidBundle() &&
          (
            // A passphrase change re-wraps the master key only. The key pair
            // stays, so a stolen session cannot swap in keys of its own.
            (request.resource.data.privateKey == resource.data.privateKey &&
             request.resource.data.publicKey == resource.data.publicKey &&
             request.resource.data.keyVersion == keyVersionOf(resource.data)) ||
            // A reset replaces lost keys with new ones: the next version,
            // published in the same write. It needs a sign-in from the last
            // few minutes, so a device left signed in cannot do it silently.
            (signedInRecently() &&
             request.resource.data.keyVersion ==
               keyVersionOf(resource.data) + 1 &&
             publishedKeysAfter().publicKey ==
               request.resource.data.publicKey &&
             publishedKeysAfter().keyVersion ==
               request.resource.data.keyVersion)
          );
      }
    }

    // A user's published X25519 public key, which chat partners seal chat keys
    // to, and the version of the keys it belongs to. Anyone signed in can read
    // it. It is written together with the user's key bundle and must match
    // the public key and version inside it. It changes only in a key reset,
    // to the next version, shortly after signing in.
    match /userKeys/{userId} {
      function isPublishedFromBundle() {
        let bundle = getAfter(
          /databases/$(database)/documents/users/$(userId)/private/encryption
        ).data;
        return request.resource.data.keys().hasOnly(['publicKey', 'keyVersion']) &&
          request.resource.data.publicKey is string &&
          request.resource.data.publicKey.size() == 44 &&
          bundle.publicKey == request.resource.data.publicKey &&
          bundle.keyVersion == request.resource.data.keyVersion;
      }

      allow read: if signedIn();
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.keyVersion == 1 &&
        isPublishedFromBundle();
      allow update: if signedIn() &&
        request.auth.uid == userId &&
        signedInRecently() &&
        request.resource.data.keyVersion == keyVersionOf(resource.data) + 1 &&
        isPublishedFromBundle();
      allow delete: if false;
    }

    // Username uniqueness index: usernames/{username} -> { uid }. Readable
    // signed out because registration checks it before the account exists;
    // an entry reveals only that a name is taken, and by which uid. Listing is
    // off, so the index cannot be enumerated.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      // Claim a name only for yourself, and only while your profile carries it
      // once the write lands (profile and claim commit together).
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['uid']) &&
        request.resource.data.uid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.username == username;
      // An entry is never rewritten. Claiming a taken name is an update of
      // someone else's entry, and this is what rejects it.
      allow update: if false;
      // Release a name only once your profile no longer carries it: renamed,
      // or deleted in the same write. Without the existsAfter branch a
      // deleted account would hold its name forever.
      allow delete: if signedIn() &&
        resource.data.uid == request.auth.uid &&
        (!existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) ||
         getAfter(/databases/$(database)/documents/users/$(request.auth.uid))
           .data.username != username);
    }

    // Friend requests are readable and writable only by their two parties.
    //
    // There is one document per pair of users: its id must be both uids,
    // sorted and joined with "_" (compositeId in the app). A request from B
    // to A therefore targets the same document as one from A to B, so a
    // duplicate or complementary request is impossible by construction rather
    // than a race the client has to win.
    match /friendRequests/{requestId} {
      function pairId(firstUid, secondUid) {
        return firstUid < secondUid
          ? firstUid + '_' + secondUid
          : secondUid + '_' + firstUid;
      }

      // A direct read is checked against the pair id itself, so it also
      // works for a request that does not exist yet (the send flow looks
      // first) without letting anyone probe for requests between other
      // people. A list query must be scoped with
      // `participantIds arrayContains <uid>`, which the app always does.
      allow get: if signedIn() && request.auth.uid in requestId.split('_');
      allow list: if signedIn() &&
        request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        // A user cannot befriend themselves.
        request.resource.data.senderId != request.resource.data.receiverId &&
        request.resource.data.status == 'Pending' &&
        requestId == pairId(request.resource.data.senderId,
                            request.resource.data.receiverId) &&
        request.resource.data.participantIds.size() == 2 &&
        request.resource.data.participantIds.hasAll([
          request.resource.data.senderId,
          request.resource.data.receiverId
        ]);
      // Only the receiver changes a request, only from Pending to Accepted,
      // and never who sent it to whom. A second request for the same pair
      // reaches this document as an update, so this is also what stops it
      // from overwriting the first.
      allow update: if signedIn() &&
        resource.data.receiverId == request.auth.uid &&
        request.resource.data.participantIds == resource.data.participantIds &&
        request.resource.data.senderId == resource.data.senderId &&
        request.resource.data.receiverId == resource.data.receiverId &&
        resource.data.status == 'Pending' &&
        request.resource.data.status == 'Accepted';
      // Either party can withdraw or decline.
      allow delete: if signedIn() &&
        (resource.data.senderId == request.auth.uid ||
         resource.data.receiverId == request.auth.uid);
    }

    // Chats are readable and writable only by their participants. Writes and
    // list queries are enforced against participantIds, the flat mirror of
    // participants that ChatDataTransferObject derives for exactly this
    // purpose (rules cannot iterate participants, which is a list of maps).
    //
    // Chats are end-to-end encrypted (docs/e2ee.md): the server holds only
    // sealed chat keys and ciphertext. Rules cannot tell whether ciphertext
    // decrypts, but they make sure nothing else is stored, so an outdated or
    // modified client cannot write a message in plaintext.
    match /chats/{chatId} {
      function participantIds() {
        return get(/databases/$(database)/documents/chats/$(chatId))
          .data.participantIds;
      }

      // Must match what ChatDataTransferObject stores; a test checks it.
      function chatFields() {
        return ['participants', 'participantIds', 'lastMessage',
                'serverTimeStamp', 'keyGenerations', 'currentKeyGeneration'];
      }

      // A generation of the chat key the caller made (KeyGeneration in the
      // app), sealed to each of [participants] and nobody else.
      function isOwnKeyGeneration(generation, participants) {
        return generation.keys().hasOnly(['createdBy', 'sealedKeys']) &&
          generation.createdBy == request.auth.uid &&
          generation.sealedKeys.keys().hasOnly(participants) &&
          isSealedChatKey(generation.sealedKeys[participants[0]]) &&
          isSealedChatKey(generation.sealedKeys[participants[1]]);
      }

      // The update adds exactly the next generation of the chat key, and
      // changes neither the earlier generations nor the last message. A
      // participant whose keys were reset does this, since they cannot open
      // the current generation any more.
      function addsNextKeyGeneration() {
        let next = resource.data.currentKeyGeneration + 1;
        let change = request.resource.data.keyGenerations
          .diff(resource.data.keyGenerations);
        return request.resource.data.currentKeyGeneration == next &&
          change.addedKeys() == [string(next)].toSet() &&
          change.changedKeys().size() == 0 &&
          change.removedKeys().size() == 0 &&
          isOwnKeyGeneration(request.resource.data.keyGenerations[string(next)],
                             resource.data.participantIds) &&
          request.resource.data.lastMessage == resource.data.lastMessage;
      }

      // The update changes only the last message, as the same write changes
      // the message itself when its sender edits or deletes it: the two stay
      // the same apart from the id the chat's copy carries. Checked last, so
      // sending a message does not pay for the extra read.
      function followsLastMessage() {
        let before = resource.data.lastMessage;
        let after = request.resource.data.lastMessage;
        let message = getAfter(
          /databases/$(database)/documents/chats/$(chatId)/messages/$(before.id)
        ).data;
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage']) &&
          before.senderId == request.auth.uid &&
          after.id == before.id &&
          after.diff(message).affectedKeys().hasOnly(['id']);
      }

      // A direct read is checked against the chat id, which the create rule
      // below ties to the participants. That lets it work for a chat that does
      // not exist yet: ChatRepository.create reads the chat in its transaction
      // before deciding to create it, and a rule over resource.data denies
      // that read, which made starting any chat fail. A list query must be
      // scoped with `participantIds arrayContains <uid>`, which the app always
      // does; Firestore checks a list against everything it could return.
      allow get: if signedIn() && request.auth.uid in chatId.split('_');
      allow list: if signedIn() &&
        request.auth.uid in resource.data.participantIds;
      // The chat id is the two participant ids, sorted and joined with "_"
      // (compositeId in the app), so the same two people always share one
      // chat document, even when both send a first message at the same
      // moment. Rules cannot sort a list, so participantIds must be stored
      // sorted. The app only creates one-to-one chats; group chats would need
      // a different id scheme here.
      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.participantIds.size() == 2 &&
        request.resource.data.participantIds[0] <
          request.resource.data.participantIds[1] &&
        chatId == request.resource.data.participantIds.join('_') &&
        request.resource.data.keys().hasOnly(chatFields()) &&
        // A chat starts at the first generation of its key, sealed to each
        // participant.
        request.resource.data.currentKeyGeneration == 1 &&
        request.resource.data.keyGenerations.keys().hasOnly(['1']) &&
        isOwnKeyGeneration(request.resource.data.keyGenerations['1'],
                           request.resource.data.participantIds) &&
        isOwnEncryptedMessage(request.resource.data.lastMessage,
                              messageFields().concat(['id']), 1);
      // The writer must already be a participant, and the participants never
      // change, which also keeps the id consistent with them. An update either
      // adds the next key generation, sets a new last message under the
      // current one, or edits or deletes the last message along with the
      // message. Existing generations never change: replacing one could lock
      // a participant out.
      allow update: if signedIn() &&
        request.auth.uid in resource.data.participantIds &&
        request.resource.data.participantIds == resource.data.participantIds &&
        request.resource.data.keys().hasOnly(chatFields()) &&
        (addsNextKeyGeneration() ||
         (request.resource.data.keyGenerations ==
            resource.data.keyGenerations &&
          request.resource.data.currentKeyGeneration ==
            resource.data.currentKeyGeneration &&
          isOwnEncryptedMessage(request.resource.data.lastMessage,
                                messageFields().concat(['id']),
                                resource.data.currentKeyGeneration)) ||
         followsLastMessage());

      match /messages/{messageId} {
        // The parent chat as it will be once this write lands.
        function chatAfter() {
          return getAfter(/databases/$(database)/documents/chats/$(chatId))
            .data;
        }

        // Reads resolve the parent chat. Safe because the UI only subscribes
        // to messages once the chat exists (ChatPage builds
        // MessagesWatcherBloc under `if (chat != null)`).
        allow read: if signedIn() && request.auth.uid in participantIds();
        // getAfter sees the chat as it will be once this write lands, so it
        // also covers the first message of a new chat, which is written in
        // the same transaction as the chat (a get() would not find it yet).
        // A message must use the chat's current key generation, so one sent
        // from an out-of-date device cannot be unreadable to a participant who
        // just reset their keys.
        // A message is dated by the server as it is written, as every version
        // of the app does. The edit window below counts from that date, so a
        // client cannot date a message ahead to keep it editable.
        allow create: if signedIn() &&
          request.auth.uid in chatAfter().participantIds &&
          request.resource.data.serverTimeStamp == request.time &&
          isOwnEncryptedMessage(request.resource.data, messageFields(),
                                chatAfter().currentKeyGeneration);

        // Must match MessageDataTransferObject.deletedFields; a test checks
        // it.
        function deletedFields() {
          return ['senderId', 'serverTimeStamp', 'deleted'];
        }

        // An edit replaces the encrypted content, under the key generation
        // the message was sent with, and marks the message edited. The app
        // offers editing for 15 minutes after sending; the rest of the 20 is
        // time to finish an edit started near the end, or for a phone whose
        // clock runs behind (messageEditSaveWindow in the app).
        function isEdit() {
          return request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['content', 'isEdited']) &&
            request.resource.data.isEdited == true &&
            request.time <
              resource.data.serverTimeStamp + duration.value(20, 'm') &&
            request.resource.data.content.v == 2 &&
            isEncryptedContent(request.resource.data.content,
                               resource.data.content.e);
        }

        // Deleting a message erases its encrypted content, and with it the
        // keys of its photos. Who sent it and when stay, so a reply to it
        // still has something to point at.
        function isDeletion() {
          return request.resource.data.keys().hasOnly(deletedFields()) &&
            request.resource.data.deleted == true &&
            request.resource.data.senderId == resource.data.senderId &&
            request.resource.data.serverTimeStamp ==
              resource.data.serverTimeStamp;
        }

        // Only the sender changes a message, by editing or deleting it, and a
        // deleted message stays deleted.
        allow update: if signedIn() &&
          request.auth.uid in chatId.split('_') &&
          resource.data.senderId == request.auth.uid &&
          resource.data.get('deleted', false) == false &&
          (isEdit() || isDeletion());
      }

      // Who is typing in the chat: one document per participant, holding the
      // server time they last typed and nothing else. Only the chat's
      // participants, whose ids make up the chat id, read it, and each writes
      // only their own. The read decides from the ids, so it also works before
      // anyone typed.
      match /typing/{userId} {
        allow read: if signedIn() && request.auth.uid in chatId.split('_');
        allow create, update: if signedIn() &&
          request.auth.uid == userId &&
          userId in chatId.split('_') &&
          request.resource.data.keys().hasOnly(['typingAt']) &&
          request.resource.data.typingAt == request.time;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      // How far each participant has read the chat, for read receipts: the
      // newest message they read, when it was sent, and the server time they
      // said so. Never what it says. Only the chat's participants read it, and
      // each writes only their own, about a message of this chat; the app
      // stops writing it, and deletes it, when the user stops sharing read
      // receipts. The read decides from the ids, so it also works before
      // anyone read.
      match /reads/{userId} {
        allow read: if signedIn() && request.auth.uid in chatId.split('_');
        allow create, update: if signedIn() &&
          request.auth.uid == userId &&
          userId in chatId.split('_') &&
          request.resource.data.keys().hasOnly(['messageId', 'messageSentAt',
                                                'readAt']) &&
          request.resource.data.readAt == request.time &&
          request.resource.data.messageId is string &&
          request.resource.data.messageSentAt == get(
            /databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.messageId)
          ).data.serverTimeStamp;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      // Reactions to the chat's messages, one document per person per
      // message, with the id "<message id>_<user id>" (neither contains "_").
      // The emoji is encrypted under the chat's current key generation
      // (docs/e2ee.md) and always the same length, so the server learns that
      // someone reacted, not with what. messageSentAt is when the message was
      // sent, which lets a chat watch the reactions to the messages it has
      // loaded. Only the chat's participants read them. Each writes only
      // their own, to a message that is not deleted; the message's sender
      // also removes the others' when deleting it.
      match /reactions/{reactionId} {
        function messageWithId(id) {
          return get(
            /databases/$(database)/documents/chats/$(chatId)/messages/$(id)
          ).data;
        }

        // Base64 of a 12-byte nonce, 128 bytes of ciphertext
        // (ChatCipher.reactionPayloadBytes) and a 16-byte tag.
        function isEncryptedReaction(content) {
          return content.keys().hasOnly(['v', 'e', 'nonce', 'cipherText', 'mac']) &&
            content.v == 1 &&
            content.e == get(/databases/$(database)/documents/chats/$(chatId))
              .data.currentKeyGeneration &&
            content.nonce is string && content.nonce.size() == 16 &&
            content.mac is string && content.mac.size() == 24 &&
            content.cipherText is string && content.cipherText.size() == 172;
        }

        allow read: if signedIn() && request.auth.uid in chatId.split('_');
        allow create, update: if signedIn() &&
          request.auth.uid in chatId.split('_') &&
          request.resource.data.keys().hasOnly(['messageId', 'userId',
                                                'messageSentAt', 'content']) &&
          request.resource.data.userId == request.auth.uid &&
          reactionId ==
            request.resource.data.messageId + '_' + request.auth.uid &&
          isEncryptedReaction(request.resource.data.content) &&
          messageWithId(request.resource.data.messageId)
            .get('deleted', false) == false &&
          request.resource.data.messageSentAt ==
            messageWithId(request.resource.data.messageId).serverTimeStamp;
        allow delete: if signedIn() &&
          request.auth.uid in chatId.split('_') &&
          (reactionId.split('_')[1] == request.auth.uid ||
           messageWithId(reactionId.split('_')[0]).senderId ==
             request.auth.uid);
      }
    }

    // Groups: up to 32 people, kept apart from one-to-one chats so versions
    // of the app from before groups never see them. See
    // FirestoreGroupRepository and docs/e2ee.md.
    match /groups/{groupId} {
      // Must match FirestoreGroupRepository.fields; a test checks it.
      function groupFields() {
        return ['memberIds', 'invitedIds', 'invitedBy', 'adminIds',
                'onlyAdminsAdd', 'profile', 'keyGenerations',
                'currentKeyGeneration', 'lastMessage', 'createdAt'];
      }

      function groupNow() {
        return get(/databases/$(database)/documents/groups/$(groupId)).data;
      }

      // Everyone the group's key is sealed to: members and the invited.
      function everyoneIn(group) {
        return group.memberIds.concat(group.invitedIds);
      }

      // A generation of the group's key the caller made, sealed to each of
      // [people] and nobody else. Rules cannot loop over a list, so only the
      // caller's own sealed key is checked for its shape: a malformed key for
      // someone else only locks that person out, which the caller could do
      // anyway by leaving them out.
      function isOwnGroupKeyGeneration(generation, people) {
        return generation.keys().hasOnly(['createdBy', 'sealedKeys']) &&
          generation.createdBy == request.auth.uid &&
          generation.sealedKeys.keys().hasOnly(people) &&
          generation.sealedKeys.keys().hasAll(people) &&
          isSealedChatKey(generation.sealedKeys[request.auth.uid]);
      }

      // The group's name and photo, encrypted under generation [generation]
      // of its key (ChatCipher.encryptGroupProfile): a photo of at most
      // 45000 bytes and a name travel in at most 70000 characters of base64.
      function isEncryptedProfile(profile, generation) {
        return profile.keys().hasOnly(['v', 'e', 'nonce', 'cipherText', 'mac']) &&
          profile.v == 1 &&
          profile.e == generation &&
          profile.nonce is string && profile.nonce.size() == 16 &&
          profile.mac is string && profile.mac.size() == 24 &&
          profile.cipherText is string && profile.cipherText.size() <= 70000;
      }

      // Any member sets the name and photo, under the current generation.
      // The server cannot tell a change from the same name encrypted again
      // for someone who joined since, which is why any member may: the chat
      // shows an event for a change.
      function setsProfile() {
        return request.auth.uid in resource.data.memberIds &&
          onlyChanges(['profile']) &&
          isEncryptedProfile(request.resource.data.profile,
                             resource.data.currentKeyGeneration);
      }

      // The update changes nothing but [fields].
      function onlyChanges(fields) {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(fields);
      }

      // The caller, a member allowed to add people (any member, or only admins
      // when the group says so), invites one person not in the group yet, and
      // is recorded as who invited them. One person a write: the rules cannot
      // loop, and an invitation recorded as a friend's would make the invited
      // person's phone join by itself.
      function addsSomeone() {
        let me = request.auth.uid;
        let before = resource.data;
        let after = request.resource.data;
        let newcomer = after.invitedIds[after.invitedIds.size() - 1];
        return me in before.memberIds &&
          (!before.get('onlyAdminsAdd', false) || me in before.adminIds) &&
          onlyChanges(['invitedIds', 'invitedBy']) &&
          after.invitedIds == before.invitedIds.concat([newcomer]) &&
          !(newcomer in before.invitedIds) &&
          !(newcomer in before.memberIds) &&
          before.memberIds.size() + after.invitedIds.size() <= 32 &&
          after.invitedBy.diff(before.invitedBy).affectedKeys() ==
            [newcomer].toSet() &&
          after.invitedBy[newcomer] == me;
      }

      // An admin takes one other person out, joined or invited, along with
      // their invitation and any admin role. Nobody is added; the admin
      // taking them out remains one.
      function removesSomeone() {
        let me = request.auth.uid;
        let before = resource.data;
        let after = request.resource.data;
        let gone = everyoneIn(before).toSet()
          .difference(everyoneIn(after).toSet());
        return me in before.adminIds &&
          onlyChanges(['memberIds', 'invitedIds', 'invitedBy', 'adminIds']) &&
          gone.size() == 1 &&
          !(me in gone) &&
          before.memberIds.hasAll(after.memberIds) &&
          before.invitedIds.hasAll(after.invitedIds) &&
          everyoneIn(after).size() == everyoneIn(before).size() - 1 &&
          after.adminIds.toSet() == before.adminIds.toSet().difference(gone) &&
          after.invitedBy.diff(before.invitedBy).addedKeys().size() == 0 &&
          after.invitedBy.diff(before.invitedBy).changedKeys().size() == 0 &&
          gone.hasAll(after.invitedBy.diff(before.invitedBy).removedKeys());
      }

      // The caller leaves. When they were the only admin, whoever has been a
      // member longest becomes one, so a group always has an admin.
      function leaves() {
        let me = request.auth.uid;
        let before = resource.data;
        let after = request.resource.data;
        let otherAdmins = before.adminIds.toSet().difference([me].toSet());
        return me in before.memberIds &&
          onlyChanges(['memberIds', 'adminIds']) &&
          after.memberIds.size() == before.memberIds.size() - 1 &&
          after.memberIds.toSet() ==
            before.memberIds.toSet().difference([me].toSet()) &&
          (otherAdmins.size() > 0
            ? after.adminIds.toSet() == otherAdmins
            : after.adminIds == [after.memberIds[0]]);
      }

      // An admin makes members admins, or stops them being admins. There is
      // always at least one, and only members are admins.
      function setsAdmins() {
        return request.auth.uid in resource.data.adminIds &&
          onlyChanges(['adminIds']) &&
          request.resource.data.adminIds.size() > 0 &&
          resource.data.memberIds.hasAll(request.resource.data.adminIds);
      }

      // An admin decides whether only admins may add people.
      function setsOnlyAdminsAdd() {
        return request.auth.uid in resource.data.adminIds &&
          onlyChanges(['onlyAdminsAdd']) &&
          request.resource.data.onlyAdminsAdd is bool;
      }

      // [me] is no longer invited, and nothing else about the invited changed.
      function leavesTheInvited(me, before, after) {
        return !(me in after.invitedIds) &&
          after.invitedIds.size() == before.invitedIds.size() - 1 &&
          after.invitedIds.toSet() ==
            before.invitedIds.toSet().difference([me].toSet()) &&
          after.invitedBy.diff(before.invitedBy).affectedKeys() ==
            [me].toSet() &&
          !(me in after.invitedBy);
      }

      // The caller, who was invited, joins: they leave the invited and are
      // added at the end of the members. Nothing else changes.
      function joinsByInvitation() {
        let me = request.auth.uid;
        let before = resource.data;
        let after = request.resource.data;
        return me in before.invitedIds &&
          after.diff(before).affectedKeys()
            .hasOnly(['memberIds', 'invitedIds', 'invitedBy']) &&
          after.memberIds == before.memberIds.concat([me]) &&
          leavesTheInvited(me, before, after);
      }

      // The caller, who was invited, turns it down. Nothing else changes.
      function turnsDownInvitation() {
        let me = request.auth.uid;
        let before = resource.data;
        let after = request.resource.data;
        return me in before.invitedIds &&
          after.diff(before).affectedKeys()
            .hasOnly(['invitedIds', 'invitedBy']) &&
          leavesTheInvited(me, before, after);
      }

      // A member sent a message: the last message becomes it, under the
      // current generation. Nothing else changes.
      function setsLastMessage() {
        return request.auth.uid in resource.data.memberIds &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage']) &&
          isOwnEncryptedMessage(request.resource.data.lastMessage,
                                messageFields().concat(['id']),
                                resource.data.currentKeyGeneration);
      }

      // A member whose keys were reset adds the next generation of the
      // group's key, sealed to everyone in the group. Earlier generations
      // never change.
      function addsNextGroupKeyGeneration() {
        let next = resource.data.currentKeyGeneration + 1;
        let change = request.resource.data.keyGenerations
          .diff(resource.data.keyGenerations);
        return request.auth.uid in resource.data.memberIds &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['keyGenerations', 'currentKeyGeneration']) &&
          request.resource.data.currentKeyGeneration == next &&
          change.addedKeys() == [string(next)].toSet() &&
          change.changedKeys().size() == 0 &&
          change.removedKeys().size() == 0 &&
          isOwnGroupKeyGeneration(
            request.resource.data.keyGenerations[string(next)],
            everyoneIn(resource.data));
      }

      // Members and the invited read the group. A list query must be scoped
      // with `memberIds arrayContains <uid>` or `invitedIds arrayContains
      // <uid>`, as FirestoreGroupRepository does.
      allow get, list: if signedIn() &&
        (request.auth.uid in resource.data.memberIds ||
         request.auth.uid in resource.data.invitedIds);

      // A group starts with the caller as its only member and admin, one to
      // 31 people invited by them, and the first generation of its key sealed
      // to all of them. Its id is "group-" and a random (version 4) UUID.
      allow create: if signedIn() &&
        groupId.matches(
          'group-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}') &&
        request.resource.data.keys().hasOnly(groupFields()) &&
        request.resource.data.keys().hasAll(['memberIds', 'invitedIds',
          'invitedBy', 'adminIds', 'keyGenerations', 'currentKeyGeneration',
          'createdAt']) &&
        request.resource.data.memberIds == [request.auth.uid] &&
        request.resource.data.adminIds == [request.auth.uid] &&
        request.resource.data.invitedIds.size() >= 1 &&
        request.resource.data.invitedIds.size() <= 31 &&
        request.resource.data.invitedIds.toSet().size() ==
          request.resource.data.invitedIds.size() &&
        !(request.auth.uid in request.resource.data.invitedIds) &&
        request.resource.data.invitedBy.keys().toSet() ==
          request.resource.data.invitedIds.toSet() &&
        request.resource.data.invitedBy.values().toSet() ==
          [request.auth.uid].toSet() &&
        request.resource.data.currentKeyGeneration == 1 &&
        request.resource.data.keyGenerations.keys().hasOnly(['1']) &&
        isOwnGroupKeyGeneration(request.resource.data.keyGenerations['1'],
                                everyoneIn(request.resource.data)) &&
        (!('onlyAdminsAdd' in request.resource.data) ||
         request.resource.data.onlyAdminsAdd is bool) &&
        (!('profile' in request.resource.data) ||
         isEncryptedProfile(request.resource.data.profile, 1)) &&
        request.resource.data.createdAt == request.time;

      allow update: if signedIn() &&
        request.resource.data.keys().hasOnly(groupFields()) &&
        (joinsByInvitation() || turnsDownInvitation() ||
         setsLastMessage() || addsNextGroupKeyGeneration() ||
         addsSomeone() || removesSomeone() || leaves() || setsAdmins() ||
         setsOnlyAdminsAdd() || setsProfile());

      // The last member leaving takes the group with them.
      allow delete: if signedIn() &&
        resource.data.memberIds == [request.auth.uid];

      match /messages/{messageId} {
        // The group as it will be once this write lands.
        function groupAfter() {
          return getAfter(/databases/$(database)/documents/groups/$(groupId))
            .data;
        }

        // The group before this write, which a batch has not changed yet.
        function groupBefore() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }

        // Must match what FirestoreGroupRepository writes for an event; a
        // test checks it.
        function eventFields() {
          return ['kind', 'type', 'senderId', 'subjectId', 'on',
                  'serverTimeStamp'];
        }

        // An event is true: the change it describes is made by the same
        // batch, by the caller (GroupEventType in the app).
        function eventHappens(event) {
          let me = request.auth.uid;
          let after = groupAfter();
          let type = event.type;
          let subject = event.get('subjectId', '');
          return
            (type == 'created' &&
              !exists(/databases/$(database)/documents/groups/$(groupId)) &&
              me in after.adminIds) ||
            (type == 'added' &&
              subject in after.invitedIds &&
              !(subject in groupBefore().invitedIds) &&
              after.invitedBy[subject] == me) ||
            (type == 'joined' &&
              me in after.memberIds && !(me in groupBefore().memberIds)) ||
            (type == 'left' &&
              me in groupBefore().memberIds && !(me in after.memberIds)) ||
            (type == 'removed' &&
              me in groupBefore().adminIds &&
              subject in everyoneIn(groupBefore()) &&
              !(subject in everyoneIn(after))) ||
            (type == 'adminAdded' &&
              subject in after.adminIds &&
              !(subject in groupBefore().adminIds)) ||
            (type == 'adminRemoved' &&
              !(subject in after.adminIds) &&
              subject in groupBefore().adminIds &&
              subject in after.memberIds) ||
            ((type == 'renamed' || type == 'photoChanged') &&
              after.get('profile', null) != groupBefore().get('profile', null)) ||
            (type == 'onlyAdminsAdd' &&
              event.on == after.onlyAdminsAdd &&
              after.onlyAdminsAdd != groupBefore().get('onlyAdminsAdd', false));
        }

        // Something that happened to the group, as a line in its chat, with no
        // text of anyone's. A subject only for the events about someone, and
        // "on" only for the switch.
        function isEvent(event) {
          return event.keys().hasOnly(eventFields()) &&
            event.kind == 'event' &&
            event.senderId == request.auth.uid &&
            event.serverTimeStamp == request.time &&
            (('subjectId' in event) ==
               (event.type in ['added', 'removed', 'adminAdded', 'adminRemoved'])) &&
            (('on' in event) == (event.type == 'onlyAdminsAdd')) &&
            eventHappens(event);
        }

        // Only members read messages: the invited hold the key, not the
        // messages, until they join.
        allow read: if signedIn() && request.auth.uid in groupNow().memberIds;
        // A message: dated by the server, under the current generation, by a
        // member. That generation must be sealed to exactly the people in
        // the group: after someone joins or leaves, a member's phone adds the
        // next one before anyone writes, so nobody who left reads what
        // follows. An event carries no text, so it needs no key, and is
        // written with its change before any new key exists.
        allow create: if signedIn() &&
          (!('kind' in request.resource.data) &&
           request.auth.uid in groupAfter().memberIds &&
           groupAfter().keyGenerations[string(groupAfter().currentKeyGeneration)]
             .sealedKeys.keys().toSet() == everyoneIn(groupAfter()).toSet() &&
           request.resource.data.serverTimeStamp == request.time &&
           isOwnEncryptedMessage(request.resource.data, messageFields(),
                                 groupAfter().currentKeyGeneration)) ||
          isEvent(request.resource.data);
        // Editing and deleting group messages come later.
        allow update, delete: if false;
      }

      // Earlier generations of the group's key, sealed to someone added with
      // the group's history (FirestoreGroupRepository.addPeople). Written in
      // the same batch as their invitation, by whoever invites them.
      match /sharedKeys/{userId} {
        function groupAfterInvite() {
          return getAfter(/databases/$(database)/documents/groups/$(groupId))
            .data;
        }

        // Only the person they are sealed to reads them.
        allow get: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() &&
          request.resource.data.keys().hasOnly(['sharedBy', 'generations']) &&
          request.resource.data.sharedBy == request.auth.uid &&
          request.auth.uid in groupAfterInvite().memberIds &&
          userId in groupAfterInvite().invitedIds &&
          groupAfterInvite().invitedBy[userId] == request.auth.uid;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      // Messages from the last day or week before someone was added, copied
      // for them alone by whoever added them (FirestoreGroupRepository
      // .addPeople): the grant here holds who shared, from when, and the key
      // of the copies sealed to [userId] as generation 0, which no real
      // generation is.
      match /history/{userId} {
        function groupAfterGrant() {
          return getAfter(/databases/$(database)/documents/groups/$(groupId))
            .data;
        }

        allow get: if signedIn() && request.auth.uid == userId;
        // Written in the same batch as the invitation, by whoever invites.
        allow create, update: if signedIn() &&
          request.resource.data.keys().hasOnly(['sharedBy', 'since', 'key']) &&
          request.resource.data.sharedBy == request.auth.uid &&
          request.resource.data.since is timestamp &&
          request.resource.data.since <= request.time &&
          isSealedChatKey(request.resource.data.key) &&
          request.auth.uid in groupAfterGrant().memberIds &&
          userId in groupAfterGrant().invitedIds &&
          groupAfterGrant().invitedBy[userId] == request.auth.uid;
        allow delete: if signedIn() && request.auth.uid == userId;

        match /messages/{messageId} {
          function grant() {
            return get(/databases/$(database)/documents/groups/$(groupId)/history/$(userId)).data;
          }
          function original() {
            return get(/databases/$(database)/documents/groups/$(groupId)/messages/$(messageId)).data;
          }

          // Only the person they were copied for, once they have joined.
          allow read: if signedIn() && request.auth.uid == userId &&
            userId in groupNow().memberIds;
          // A copy of a real message from the shared window, by whoever
          // shared it, keeping the message's sender and time, encrypted
          // under generation 0. The rules cannot compare what the copy says
          // with the message: the person added trusts whoever added them
          // for that.
          allow create, update: if signedIn() &&
            grant().sharedBy == request.auth.uid &&
            request.auth.uid in groupNow().memberIds &&
            request.resource.data.keys().hasOnly(messageFields()) &&
            request.resource.data.senderId == original().senderId &&
            request.resource.data.serverTimeStamp == original().serverTimeStamp &&
            original().serverTimeStamp >= grant().since &&
            isEncryptedContent(request.resource.data.content, 0);
          allow delete: if signedIn() && request.auth.uid == userId;
        }
      }
    }

    // Reports of abuse. Chats are end-to-end encrypted, so a report carries
    // only what its author chose to share: a reason, and at most the last 5
    // messages of the chat in readable form (ReportedMessage.maxPerReport).
    // Anyone signed in files one, about someone else, as themselves, from a
    // chat they are in. No app can read, change or delete one: the project
    // owner reviews them in the Firebase console. The messages are the
    // author's word; the server cannot check them against the ciphertext.
    match /reports/{reportId} {
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['reporterId', 'reportedId',
                                              'chatId', 'reason', 'messages',
                                              'createdAt']) &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.reportedId is string &&
        request.resource.data.reportedId != request.auth.uid &&
        request.resource.data.reason in ['spam', 'harassment', 'inappropriate',
                                         'impersonation', 'other'] &&
        request.resource.data.messages is list &&
        request.resource.data.messages.size() <= 5 &&
        request.resource.data.createdAt == request.time &&
        (request.resource.data.get('chatId', null) == null ||
         request.auth.uid in request.resource.data.chatId.split('_'));
      allow read, update, delete: if false;
    }

    // Whether a user's app is on screen, and the server time it last said so,
    // for their friends. Only the user writes it, and only people with an
    // accepted friend request with them read it. That request's id is both
    // uids sorted and joined with "_", so the rule finds it without a query.
    match /presence/{userId} {
      function friendsWithCaller() {
        let pair = request.auth.uid < userId
          ? request.auth.uid + '_' + userId
          : userId + '_' + request.auth.uid;
        let requestPath = /databases/$(database)/documents/friendRequests/$(pair);
        return exists(requestPath) && get(requestPath).data.status == 'Accepted';
      }

      allow get: if signedIn() &&
        (request.auth.uid == userId || friendsWithCaller());
      allow list: if false;
      allow create, update: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['state', 'lastSeenAt']) &&
        request.resource.data.state in ['online', 'offline'] &&
        request.resource.data.lastSeenAt == request.time;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
