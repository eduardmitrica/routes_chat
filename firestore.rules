rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // True when, once the current write lands, the `usernames` entry for
    // [username] belongs to the caller.
    function claimsUsername(username) {
      return getAfter(/databases/$(database)/documents/usernames/$(username))
        .data.uid == request.auth.uid;
    }

    // True when the caller signed in, or confirmed their sign-in, in the last
    // 5 minutes. `auth_time` is that moment in seconds; refreshing the ID
    // token does not change it.
    function signedInRecently() {
      return request.time <
        timestamp.value(request.auth.token.auth_time * 1000) +
          duration.value(5, 'm');
    }

    // The version of stored keys. Keys from before key resets existed carry
    // none: they are a user's first.
    function keyVersionOf(keys) {
      return keys.get('keyVersion', 1);
    }

    // Profiles are readable by any signed-in user, because username search
    // looks up other users; registration checks uniqueness against the
    // `usernames` index below, and the Google flows sign in first and read the
    // caller's own profile. Because anyone signed in can read them, profiles
    // hold only what everyone may see. Email addresses live in Firebase Auth
    // alone, and `hasOnly(profileFields())` rejects any other field, so an old
    // or modified client cannot write one back.
    //
    // A profile may only carry a username whose index entry belongs to the
    // same uid once the write lands, which makes uniqueness enforced here
    // rather than a client-side courtesy.
    match /users/{userId} {
      // Must match the fields UserDataTransferObject stores; a test checks it.
      function profileFields() {
        return ['username', 'imageUrl', 'description'];
      }

      allow read: if signedIn();
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(profileFields()) &&
        claimsUsername(request.resource.data.username);
      allow update: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(profileFields()) &&
        (request.resource.data.username == resource.data.username ||
         claimsUsername(request.resource.data.username));
      allow delete: if signedIn() && request.auth.uid == userId;

      // This user's devices for push notifications, one document per FCM
      // token. Private to the owner, who adds a device when signing in and
      // removes it before signing out. The notifyNewMessage Cloud Function
      // reads them with the Admin SDK, which is not subject to these rules.
      match /fcmTokens/{token} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() &&
          request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['platform', 'updatedAt']) &&
          request.resource.data.updatedAt == request.time;
      }

      // The user's end-to-end encryption keys (see docs/e2ee.md). Everything
      // in the bundle except the public key is encrypted, but only the owner
      // has any reason to read it. The client can never delete it, because
      // losing it would make every earlier message unreadable.
      match /private/{document} {
        // Must match what KeyBundle stores; a test checks it.
        function encryptionBundleFields() {
          return ['version', 'keyVersion', 'kdf', 'masterKeyByPassphrase',
                  'masterKeyByRecoveryKey', 'privateKey', 'publicKey'];
        }

        function isValidBundle() {
          return document == 'encryption' &&
            request.resource.data.keys().hasOnly(encryptionBundleFields()) &&
            request.resource.data.version == 1 &&
            request.resource.data.keyVersion is int;
        }

        // The published public key as it will be once this write lands.
        function publishedKeysAfter() {
          return getAfter(/databases/$(database)/documents/userKeys/$(userId))
            .data;
        }

        allow read: if signedIn() && request.auth.uid == userId;
        // Created together with the published public key, which must match.
        allow create: if signedIn() &&
          request.auth.uid == userId &&
          isValidBundle() &&
          request.resource.data.keyVersion == 1 &&
          publishedKeysAfter().publicKey == request.resource.data.publicKey;
        allow update: if signedIn() &&
          request.auth.uid == userId &&
          isValidBundle() &&
          (
            // A passphrase change re-wraps the master key only. The key pair
            // stays, so a stolen session cannot swap in keys of its own.
            (request.resource.data.privateKey == resource.data.privateKey &&
             request.resource.data.publicKey == resource.data.publicKey &&
             request.resource.data.keyVersion == keyVersionOf(resource.data)) ||
            // A reset replaces lost keys with new ones: the next version,
            // published in the same write. It needs a sign-in from the last
            // few minutes, so a device left signed in cannot do it silently.
            (signedInRecently() &&
             request.resource.data.keyVersion ==
               keyVersionOf(resource.data) + 1 &&
             publishedKeysAfter().publicKey ==
               request.resource.data.publicKey &&
             publishedKeysAfter().keyVersion ==
               request.resource.data.keyVersion)
          );
      }
    }

    // A user's published X25519 public key, which chat partners seal chat keys
    // to, and the version of the keys it belongs to. Anyone signed in can read
    // it. It is written together with the user's key bundle and must match
    // the public key and version inside it. It changes only in a key reset,
    // to the next version, shortly after signing in.
    match /userKeys/{userId} {
      function isPublishedFromBundle() {
        let bundle = getAfter(
          /databases/$(database)/documents/users/$(userId)/private/encryption
        ).data;
        return request.resource.data.keys().hasOnly(['publicKey', 'keyVersion']) &&
          request.resource.data.publicKey is string &&
          request.resource.data.publicKey.size() == 44 &&
          bundle.publicKey == request.resource.data.publicKey &&
          bundle.keyVersion == request.resource.data.keyVersion;
      }

      allow read: if signedIn();
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.keyVersion == 1 &&
        isPublishedFromBundle();
      allow update: if signedIn() &&
        request.auth.uid == userId &&
        signedInRecently() &&
        request.resource.data.keyVersion == keyVersionOf(resource.data) + 1 &&
        isPublishedFromBundle();
      allow delete: if false;
    }

    // Username uniqueness index: usernames/{username} -> { uid }. Readable
    // signed out because registration checks it before the account exists;
    // an entry reveals only that a name is taken, and by which uid. Listing is
    // off, so the index cannot be enumerated.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      // Claim a name only for yourself, and only while your profile carries it
      // once the write lands (profile and claim commit together).
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['uid']) &&
        request.resource.data.uid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.username == username;
      // An entry is never rewritten. Claiming a taken name is an update of
      // someone else's entry, and this is what rejects it.
      allow update: if false;
      // Release a name only once your profile no longer carries it: renamed,
      // or deleted in the same write. Without the existsAfter branch a
      // deleted account would hold its name forever.
      allow delete: if signedIn() &&
        resource.data.uid == request.auth.uid &&
        (!existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) ||
         getAfter(/databases/$(database)/documents/users/$(request.auth.uid))
           .data.username != username);
    }

    // Friend requests are readable and writable only by their two parties.
    //
    // There is one document per pair of users: its id must be both uids,
    // sorted and joined with "_" (compositeId in the app). A request from B
    // to A therefore targets the same document as one from A to B, so a
    // duplicate or complementary request is impossible by construction rather
    // than a race the client has to win.
    match /friendRequests/{requestId} {
      function pairId(firstUid, secondUid) {
        return firstUid < secondUid
          ? firstUid + '_' + secondUid
          : secondUid + '_' + firstUid;
      }

      // A direct read is checked against the pair id itself, so it also
      // works for a request that does not exist yet (the send flow looks
      // first) without letting anyone probe for requests between other
      // people. A list query must be scoped with
      // `participantIds arrayContains <uid>`, which the app always does.
      allow get: if signedIn() && request.auth.uid in requestId.split('_');
      allow list: if signedIn() &&
        request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        // A user cannot befriend themselves.
        request.resource.data.senderId != request.resource.data.receiverId &&
        request.resource.data.status == 'Pending' &&
        requestId == pairId(request.resource.data.senderId,
                            request.resource.data.receiverId) &&
        request.resource.data.participantIds.size() == 2 &&
        request.resource.data.participantIds.hasAll([
          request.resource.data.senderId,
          request.resource.data.receiverId
        ]);
      // Only the receiver changes a request, only from Pending to Accepted,
      // and never who sent it to whom. A second request for the same pair
      // reaches this document as an update, so this is also what stops it
      // from overwriting the first.
      allow update: if signedIn() &&
        resource.data.receiverId == request.auth.uid &&
        request.resource.data.participantIds == resource.data.participantIds &&
        request.resource.data.senderId == resource.data.senderId &&
        request.resource.data.receiverId == resource.data.receiverId &&
        resource.data.status == 'Pending' &&
        request.resource.data.status == 'Accepted';
      // Either party can withdraw or decline.
      allow delete: if signedIn() &&
        (resource.data.senderId == request.auth.uid ||
         resource.data.receiverId == request.auth.uid);
    }

    // Chats are readable and writable only by their participants. Writes and
    // list queries are enforced against participantIds, the flat mirror of
    // participants that ChatDataTransferObject derives for exactly this
    // purpose (rules cannot iterate participants, which is a list of maps).
    //
    // Chats are end-to-end encrypted (docs/e2ee.md): the server holds only
    // sealed chat keys and ciphertext. Rules cannot tell whether ciphertext
    // decrypts, but they make sure nothing else is stored, so an outdated or
    // modified client cannot write a message in plaintext.
    match /chats/{chatId} {
      function participantIds() {
        return get(/databases/$(database)/documents/chats/$(chatId))
          .data.participantIds;
      }

      // Must match what ChatDataTransferObject stores; a test checks it.
      function chatFields() {
        return ['participants', 'participantIds', 'lastMessage',
                'serverTimeStamp', 'keyGenerations', 'currentKeyGeneration'];
      }

      // Must match what MessageDataTransferObject stores; a test checks it.
      // A chat's lastMessage also carries the message's id. Older versions of
      // the app also write repliedMessageId, always "Empty", which stays
      // allowed so they keep working: a reply's link is now encrypted.
      function messageFields() {
        return ['senderId', 'imageUrls', 'reactions', 'content',
                'repliedMessageId', 'isEdited', 'serverTimeStamp'];
      }

      // A message encrypted under generation [generation] of the chat key
      // (EncryptedContent in the app): base64 of a 12-byte nonce, the
      // ciphertext and a 16-byte tag. A message is at most 1000 UTF-16 code
      // units. Version 1, which older versions of the app still write, holds
      // the text alone: at most 3000 bytes of UTF-8, 4000 characters of
      // base64. Version 2 holds, as JSON, the text, any quote and the list of
      // attached photos and GIFs with their keys and small previews. Escapes
      // take up to six bytes a code unit, and ten attachments with previews
      // about 22000 bytes: at most 36000 bytes, 48000 characters.
      function isEncryptedContent(content, generation) {
        return content.keys().hasOnly(['v', 'e', 'nonce', 'cipherText', 'mac']) &&
          content.e == generation &&
          content.nonce is string && content.nonce.size() == 16 &&
          content.mac is string && content.mac.size() == 24 &&
          content.cipherText is string &&
          ((content.v == 1 && content.cipherText.size() <= 4000) ||
           (content.v == 2 && content.cipherText.size() <= 48000));
      }

      // The chat key sealed to one participant (SealedChatKey in the app):
      // base64 of a 32-byte ephemeral X25519 public key, a 12-byte nonce, the
      // 32-byte encrypted key and a 16-byte tag, and the version of the
      // participant's keys it was sealed to.
      function isSealedChatKey(sealed) {
        return sealed.keys().hasOnly(['ephemeralPublicKey', 'nonce',
                                      'cipherText', 'mac', 'keyVersion']) &&
          sealed.ephemeralPublicKey is string &&
          sealed.ephemeralPublicKey.size() == 44 &&
          sealed.nonce is string && sealed.nonce.size() == 16 &&
          sealed.cipherText is string && sealed.cipherText.size() == 44 &&
          sealed.mac is string && sealed.mac.size() == 24 &&
          sealed.keyVersion is int;
      }

      // A generation of the chat key the caller made (KeyGeneration in the
      // app), sealed to each of [participants] and nobody else.
      function isOwnKeyGeneration(generation, participants) {
        return generation.keys().hasOnly(['createdBy', 'sealedKeys']) &&
          generation.createdBy == request.auth.uid &&
          generation.sealedKeys.keys().hasOnly(participants) &&
          isSealedChatKey(generation.sealedKeys[participants[0]]) &&
          isSealedChatKey(generation.sealedKeys[participants[1]]);
      }

      // A message the caller wrote under generation [generation], holding only
      // the fields the app stores, with its text encrypted.
      function isOwnEncryptedMessage(message, fields, generation) {
        return message.keys().hasOnly(fields) &&
          message.senderId == request.auth.uid &&
          isEncryptedContent(message.content, generation);
      }

      // The update adds exactly the next generation of the chat key, and
      // changes neither the earlier generations nor the last message. A
      // participant whose keys were reset does this, since they cannot open
      // the current generation any more.
      function addsNextKeyGeneration() {
        let next = resource.data.currentKeyGeneration + 1;
        let change = request.resource.data.keyGenerations
          .diff(resource.data.keyGenerations);
        return request.resource.data.currentKeyGeneration == next &&
          change.addedKeys() == [string(next)].toSet() &&
          change.changedKeys().size() == 0 &&
          change.removedKeys().size() == 0 &&
          isOwnKeyGeneration(request.resource.data.keyGenerations[string(next)],
                             resource.data.participantIds) &&
          request.resource.data.lastMessage == resource.data.lastMessage;
      }

      // A direct read is checked against the chat id, which the create rule
      // below ties to the participants. That lets it work for a chat that does
      // not exist yet: ChatRepository.create reads the chat in its transaction
      // before deciding to create it, and a rule over resource.data denies
      // that read, which made starting any chat fail. A list query must be
      // scoped with `participantIds arrayContains <uid>`, which the app always
      // does; Firestore checks a list against everything it could return.
      allow get: if signedIn() && request.auth.uid in chatId.split('_');
      allow list: if signedIn() &&
        request.auth.uid in resource.data.participantIds;
      // The chat id is the two participant ids, sorted and joined with "_"
      // (compositeId in the app), so the same two people always share one
      // chat document, even when both send a first message at the same
      // moment. Rules cannot sort a list, so participantIds must be stored
      // sorted. The app only creates one-to-one chats; group chats would need
      // a different id scheme here.
      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.participantIds.size() == 2 &&
        request.resource.data.participantIds[0] <
          request.resource.data.participantIds[1] &&
        chatId == request.resource.data.participantIds.join('_') &&
        request.resource.data.keys().hasOnly(chatFields()) &&
        // A chat starts at the first generation of its key, sealed to each
        // participant.
        request.resource.data.currentKeyGeneration == 1 &&
        request.resource.data.keyGenerations.keys().hasOnly(['1']) &&
        isOwnKeyGeneration(request.resource.data.keyGenerations['1'],
                           request.resource.data.participantIds) &&
        isOwnEncryptedMessage(request.resource.data.lastMessage,
                              messageFields().concat(['id']), 1);
      // The writer must already be a participant, and the participants never
      // change, which also keeps the id consistent with them. An update either
      // adds the next key generation, or sets a new last message under the
      // current one. Existing generations never change: replacing one could
      // lock a participant out.
      allow update: if signedIn() &&
        request.auth.uid in resource.data.participantIds &&
        request.resource.data.participantIds == resource.data.participantIds &&
        request.resource.data.keys().hasOnly(chatFields()) &&
        (addsNextKeyGeneration() ||
         (request.resource.data.keyGenerations ==
            resource.data.keyGenerations &&
          request.resource.data.currentKeyGeneration ==
            resource.data.currentKeyGeneration &&
          isOwnEncryptedMessage(request.resource.data.lastMessage,
                                messageFields().concat(['id']),
                                resource.data.currentKeyGeneration)));

      match /messages/{messageId} {
        // The parent chat as it will be once this write lands.
        function chatAfter() {
          return getAfter(/databases/$(database)/documents/chats/$(chatId))
            .data;
        }

        // Reads resolve the parent chat. Safe because the UI only subscribes
        // to messages once the chat exists (ChatPage builds
        // MessagesWatcherBloc under `if (chat != null)`).
        allow read: if signedIn() && request.auth.uid in participantIds();
        // getAfter sees the chat as it will be once this write lands, so it
        // also covers the first message of a new chat, which is written in
        // the same transaction as the chat (a get() would not find it yet).
        // A message must use the chat's current key generation, so one sent
        // from an out-of-date device cannot be unreadable to a participant who
        // just reset their keys.
        allow create: if signedIn() &&
          request.auth.uid in chatAfter().participantIds &&
          isOwnEncryptedMessage(request.resource.data, messageFields(),
                                chatAfter().currentKeyGeneration);
      }
    }
  }
}
