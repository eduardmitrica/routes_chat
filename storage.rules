rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Generic placeholder avatar. Read must stay public: PlaceholderFetcherBloc
    // is built with lazy:false in AppWidget and fetches this at app launch,
    // before sign-in, and the register form needs it before an account exists.
    // Upload it from the console — client writes are blocked.
    match /placeholders/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Photos and GIFs sent in chats, each encrypted on the phone with a key
    // only the chat's participants have (docs/e2ee.md): the server stores
    // bytes it cannot read. Only the two participants, whose ids make up the
    // chat id, can read or add them, and a file never changes once stored.
    // The size limit is MediaLimits.maxStoredBytes; a test checks it.
    match /chat_media/{chatId}/{fileName} {
      allow read: if request.auth != null &&
        request.auth.uid in chatId.split('_');
      allow create: if request.auth != null &&
        request.auth.uid in chatId.split('_') &&
        request.resource.size <= 15728668 &&
        request.resource.contentType == 'application/octet-stream' &&
        request.resource.metadata.uploader == request.auth.uid;
      // Only whoever uploaded a file can delete it, such as a file of a
      // message they gave up sending.
      allow delete: if request.auth != null &&
        request.auth.uid in chatId.split('_') &&
        resource.metadata.uploader == request.auth.uid;
    }

    // Photos and GIFs sent in groups, encrypted on the phone like a chat's
    // (docs/e2ee.md). Storage rules cannot read the app's named Firestore
    // database, so they cannot check who is in a group. Instead each file
    // has a random (version 4) UUID for a name, which nobody can guess and
    // nobody can list, and holds only ciphertext whose key travels inside
    // the group's encrypted messages. Anyone signed in may fetch a file by
    // its exact name or add one under a group's id, named by themselves as
    // uploader; only the uploader deletes it, and a file never changes. The
    // size limit is MediaLimits.maxStoredBytes; a test checks it.
    match /group_media/{groupId}/{fileName} {
      allow get: if request.auth != null &&
        groupId.matches('group-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}') &&
        fileName.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}');
      allow create: if request.auth != null &&
        groupId.matches('group-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}') &&
        fileName.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}') &&
        request.resource.size <= 15728668 &&
        request.resource.contentType == 'application/octet-stream' &&
        request.resource.metadata.uploader == request.auth.uid;
      allow delete: if request.auth != null &&
        resource.metadata.uploader == request.auth.uid;
    }

    // Each user's profile photo: anyone signed in can view it (shown in
    // chats/friends lists), only the owner can upload/replace it.
    match /user_images/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        fileName == request.auth.uid + '.jpg';
    }
  }
}
